#!/bin/sh
#purpose: run Kmer counter
#author: Manisha

input_path="../input_data/"

outputs_path2mer="../outputs_data/2mer/"
outputs_path3mer="../outputs_data/3mer/"
outputs_path4mer="../outputs_data/4mer/"

echo "Generating 2mer features"

for file in `cat list.txt`;
do 
	#===========================================================================================================
	#Run kanalyzer to generate k-mer counts
	
	if [ -f ./$outputs_path/$file.txt ];
	then
		printf "file exists!!\n";
	else
		printf "running kanalyzer...";
		java -Xmx3G -jar kanalyze.jar count -k 2 -f fasta -o $outputs_path2mer/$file.txt $input_path/$file;
		printf "...DONE!!!\n";
	fi
	#===========================================================================================================
done

